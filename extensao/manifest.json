{
  "manifest_version": 3,
  "name": "Círculo — revisão de contas seguidas",
  "version": "1.1.0",
  "description": "Importe sua lista, selecione contas e revise ações na sua lista Seguindo do Instagram.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Abrir Círculo", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "content_scripts": [{
    "matches": ["https://www.instagram.com/*"],
    "js": ["instagram-content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
